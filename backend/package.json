{
  "name": "pawfinder-backend",
  "version": "1.4.0",
  "description": "Backend PawFinder - REST API, ingest telemetri alat (USB serial / HTTP), geofencing, dan live stream (SSE).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:usb": "node src/server.js --usb",
    "start:sim": "node src/server.js --simulator",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "reset": "node src/seed.js --reset --yes",
    "ports": "node tools/list-ports.js",
    "bridge": "node tools/usb-bridge.js",
    "simulate": "node tools/simulate-device.js",
    "test": "node test/run-all.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "firebase-admin": "^14.5.1"
  }
}
