# Salin menjadi .env lalu ubah sesuai kebutuhan
PORT=4000
HOST=0.0.0.0
JWT_SECRET=ganti-dengan-rahasia-panjang-dan-acak
# Kunci yang harus dikirim perangkat GPS lewat header x-device-key
DEVICE_KEY=pawfinder-device-key
# on = hewan demo bergerak otomatis, off = hanya menerima telemetri asli
SIMULATOR=on
SIM_INTERVAL_MS=4000
# Lokasi file database JSON (opsional)
# DATA_FILE=./data/db.json
# Folder frontend web yang disajikan oleh server (opsional)
# WEB_DIR=../web
