# ============================================================
#  PawFinder backend - salin file ini menjadi ".env" lalu isi.
#  (cp .env.example .env   |   Windows: copy .env.example .env)
# ============================================================

# --- Server ---
PORT=4000
HOST=0.0.0.0
# development | production  (production menolak start bila kunci di bawah masih bawaan)
NODE_ENV=development

# --- Keamanan (WAJIB diganti pada produksi) ---
# Kosongkan JWT_SECRET agar dibuat otomatis & disimpan di backend/data/jwt.secret.
# Produksi: isi minimal 32 karakter acak, mis.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Kunci yang harus dikirim alat/bridge (header x-device-key). Samakan dengan firmware/bridge.
DEVICE_KEY=pawfinder-device-key
# Produksi: alamat aplikasi web yang diizinkan, pisahkan dengan koma. Contoh: https://app.contoh.com
CORS_ORIGIN=*
# Isi 1 hanya bila server berada di belakang reverse proxy tepercaya (Nginx/Caddy)
TRUST_PROXY=0

# --- Akun awal (opsional, untuk pengembangan) ---
# Bila diisi, akun ini dibuat otomatis saat database masih kosong. Kosongkan untuk produksi.
SEED_NAME=Pemilik PawFinder
SEED_EMAIL=
SEED_PASSWORD=

# --- Kabel USB ke Arduino (alat nyata) ---
# Kosong = nonaktif | auto = deteksi Arduino otomatis | COM3 (Windows) | /dev/ttyACM0 (Linux) | /dev/cu.usbmodem1101 (macOS)
USB_PORT=
USB_BAUD=9600
# ID alat bila firmware/modul GPS tidak mengirim ID sendiri (format PF-XXX-000000)
USB_SERIAL=
# Koordinat TETAP untuk prototipe tanpa modul GPS (kosongkan bila alat punya GPS)
USB_FALLBACK_LAT=
USB_FALLBACK_LNG=
# Detik tanpa data sebelum alat dinyatakan offline (minimal 15)
OFFLINE_AFTER_SEC=90

# --- Simulator (hanya untuk demo tanpa alat) ---
# on = kalung yang dipasangkan bergerak sendiri (DATA PALSU). Matikan saat memakai alat asli.
SIMULATOR=off
SIM_INTERVAL_MS=4000

# --- Lokasi file data ---
# DATA_FILE=./data/db.json
# --- Lokasi build web Flutter (opsional, disajikan di http://server:PORT/) ---
# WEB_DIR=../build/web
